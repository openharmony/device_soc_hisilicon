if (defined(ohos_lite)) {
  import("//build/lite/config/component/lite_component.gni")
  import("//build/ohos/kernel/kernel.gni")
  group("hispark_aifly_sdk") {
    deps = [ ":sdk_make" ]
  }

  build_ext_component("sdk_make") {
    exec_path = rebase_path(".", root_build_dir)
    outdir = rebase_path("$root_out_dir")
    clang_dir = ""
    if (ohos_build_compiler_dir != "") {
      clang_dir = rebase_path("$ohos_build_compiler_dir")
    }
    chip = "ss928v100"
    if (board_name == "hispark_aiflylite") {
      chip = "ss927v100"
    }
    command = "chmod +x ./build.sh && ./build.sh ${ohos_root_path} ${outdir} y ${clang_dir} ${linux_kernel_version} ${chip}"
    deps = [ "//device/board/hisilicon/${device_name}/kernel:build_kernel" ]
  }
}
